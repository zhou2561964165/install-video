[Unit]
Description=Wake once at this project's Bilibili cookie renewal deadline

[Timer]
# The root scheduler replaces this parking date in next.conf using Cookie expiry.
OnCalendar=2099-01-01 00:00:00 UTC
Unit=install-video-bili-session-refresh.service
Persistent=true
AccuracySec=1s
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
