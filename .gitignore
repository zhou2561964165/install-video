# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
dist/
.vite/
*.local

# Local Live2D model bundles are excluded from GitHub publication.
/frontend/public/live2d/*
!/frontend/public/live2d/live2dcubismcore.min.js

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Env / secrets
.env
.env.*
# 本机开发账号额度配置（按现有 user ID 授权，不发布到其他环境）
/backend/dev-quota-policy.json

# Runtime temp (server-side downloads)
backend/tmp/
/tmp/
*.log

# Visual companion mockups
.superpowers/

# SQLite (init_db 会生成 jobs.db；旧库重命名残留 *.stale-backup-*)
*.db
*.stale-backup-*

# Playwright MCP 运行产物（日志/截图/yaml）
.playwright-mcp/

# 多余 npm lockfile stub（非项目代码；真锁文件是 uv.lock（Python）+ frontend/package-lock.json（前端））
/package-lock.json
/docs/package-lock.json

# 屏幕截图 / 验证 / 计划草稿（本地产物，不入库）
# 注意：frontend/public/live2d 下有源贴图 .png，故不全局忽略 *.png，仅忽略根级临时截图
/*.png
/verify/
.planning/
