# Copy to backend/.env and set deployment-specific values.
# Never commit the resulting .env, real API keys, or Cookie files.
JWT_SECRET=replace-with-a-long-random-secret
FFMPEG_PATH=ffmpeg
MEMBERSHIP_UNLIMITED_DOWNLOADS=true
MEMBERSHIP_FREE_MAX_HEIGHT=720

# Optional model API. Leave empty to keep generation unconfigured.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
SUMMARY_MAX_SOURCE_CHARS=60000
SUMMARY_LONG_THRESHOLD_CHARS=20000
LLM_LONG_SUMMARY_MODEL=deepseek-v4-pro

# Optional local transcription: uv sync --frozen --extra asr
ASR_MODEL=tiny
ASR_MODEL_PATH=
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

# Optional Bilibili session; provide only an external local file path.
BILIBILI_COOKIE_FILE=
BILIBILI_API_ENABLED=false

# Optional Stripe Checkout. A payment-mode Price is required for this example.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_BILLING_MODE=payment
STRIPE_PRICE_LABEL=9.9 CNY / 30 days
STRIPE_PUBLIC_ORIGIN=http://localhost:5173
STRIPE_VIP_DURATION_DAYS=30
