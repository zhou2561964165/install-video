        {
          "id": "F5_2",
          "source_id": "part5",
          "source_sha256": "8b00185ce8c2bbe7cc16e4b274fb3dd7fcae70d7be002edcf12c3e5c706a25fc",
          "start": 32444,
          "end": 32569,
          "quote": "Once we've created expressions,\nand we have these assignments,\nyou can rebind variable\nnames using new assignment\nstatements.",
          "topic": "通过新赋值语句重新绑定变量名",
          "claim": "创建表达式和赋值后，可以通过新的赋值语句重新绑定变量名。",
          "evidence_indices": [
            21,
