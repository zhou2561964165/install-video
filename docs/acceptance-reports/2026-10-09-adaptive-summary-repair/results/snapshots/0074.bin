            107,
            108
          ],
          "attribution": "source",
          "importance": "core",
          "attribution_start": null,
          "attribution_end": null
        },
        {
          "id": "F5_6",
          "source_id": "part5",
          "source_sha256": "8b00185ce8c2bbe7cc16e4b274fb3dd7fcae70d7be002edcf12c3e5c706a25fc",
          "start": 34522,
          "end": 34658,
          "quote": "Next lecture, we're going\nto talk about adding control\nflow to our programs, so\nhow do you tell the computer\nto do one thing or another?",
          "topic": "下一讲预告：控制流",
          "claim": "下一讲将讨论为程序添加控制流，即如何告诉计算机做一件事或另一件事。",
          "evidence_indices": [
