      "candidate": {
        "summary": [
          {
            "text": "Ana Bell 与 Eric Grimson 讲授 6.0001/600，首讲先讲行政事务，再从高层次讨论计算并进入 Python 基础。课程节奏快，需提前下载幻灯片与代码、跟随练习；编程靠大量练习，新手不必怕弄坏电脑。课程目标为概念知识、编程技能与通过 psets 培养的解决问题能力，内容分编程、良好代码风格与比较程序效率三部分。计算即执行大量计算并存储结果，计算机只做被明确告知的事。",
            "fact_ids": [
              "F1_5",
              "F5_5"
            ]
          }
        ],
        "key_points": [
          {
            "topic": "课程安排与学习方式",
            "text": "Ana Bell 与 Eric Grimson 讲授 6.0001/600；首讲先讲行政事务，再高层次讨论计算并进入 Python 基础。课程节奏快，建议提前下载幻灯片与代码、跟随练习；编程靠大量练习，新手不必怕弄坏电脑。",
            "fact_ids": [
              "F1_1",
              "F1_2"
            ]
          },
          {
            "topic": "课程目标与内容板块",
            "text": "课程希望学生获得概念知识、编程技能与通过 psets 培养的解决问题能力，基础是大量练习。内容分三部分：学习编程（对象、数据结构、控制流）、写可读且模块化的好代码、比较 Python 程序的优劣与效率。",
            "fact_ids": [
              "F1_5",
              "F1_6"
            ]
          },
          {
            "topic": "计算、知识与算法",
            "text": "计算机执行大量计算并存储结果，只做被明确告知的事。陈述性知识是事实，命令式知识是配方；配方含步骤序列、控制流与停止方式，即算法。求平方根用猜测、检验接近、平均更新并重复的步骤说明。",
            "fact_ids": [
              "F1_10",
              "F2_2",
              "F2_7",
              "F5_5"
            ]
          },
          {
            "topic": "机器架构与可计算性",
            "text": "固定程序计算机只能做一件事；存储程序计算机可存储并更换指令序列。基本架构含内存、输入输出、ALU 与控制单元，程序计数器逐条执行，测试可改变控制流。图灵用六种原语表明可计算任何东西，故 Python 能算的也可用其他语言实现。",
            "fact_ids": [
              "F2_12",
              "F3_2"
            ]
          },
          {
            "topic": "语言语法、语义与程序含义",
            "text": "原语可组合成表达式；英语与 Python 都需语法与静态语义，如名词动词名词有效，而把数字加到单词上无意义。英语可有歧义，但程序只有一种含义；程序可能不按意图运行、崩溃或不停止，语法与静态语义错误可被 Python 捕获。",
            "fact_ids": [
              "F3_7",
              "F3_8"
            ]
          },
          {
            "topic": "Python 对象、类型与运算",
            "text": "Python 中一切皆对象，分标量与可再分的非标量；标量含整数、浮点数、布尔值与 NoneType。可用 type 查询、用类型名转换（转整数截断）。表达式由对象与运算符组成，结果类型取决于操作数，除法总返回浮点数；百分号取余，双星号幂运算。",
            "fact_ids": [
              "F4_1",
              "F4_3",
              "F4_7"
            ]
          },
          {
            "topic": "变量赋值与重新绑定",
            "text": "等号是赋值：右侧求值为值，左侧只能是变量名，应具描述性。赋值把名字绑定到内存中的值，如 pi、radius 计算圆面积。重新绑定 radius 后旧值失去句柄，area 不会自动重算，因为计算机只做被明确告知的事；下一讲讲控制流。",
            "fact_ids": [
              "F4_8",
              "F4_9"
            ]
          }
        ]
      },
      "theme_plan": [
        {
          "point_index": 1,
          "topic": "课程安排与学习方式",
          "principle": "Ana Bell 与 Eric Grimson 共同讲授 6.0001/600；首讲先处理行政事务，再从高层次讨论计算并进入 Python 基础。课程节奏快、进度提升迅速，因此建议提前下载幻灯片与代码、跟随课堂练习；编程需像数学或阅读一样大量练习，新手不必担心弄坏电脑，最坏只是重启。",
          "conditions": [
            "课程节奏快、进度提升迅速",
            "学生若为编程新手"
          ],
          "consequences": [
            "提前下载幻灯片与代码并跟随练习有助于学习",
            "大量练习是掌握编程的关键",
            "新手可放心尝试输入代码并观察结果"
          ],
          "hint_ids": [
            "F1_1",
            "F1_2",
            "F1_3",
            "F1_4"
          ]
        },
        {
          "point_index": 2,
          "topic": "课程目标与内容板块",
          "principle": "课程希望学生获得三样东西：概念知识、编程技能，以及通过 psets 培养的解决问题能力，基础是大量练习和编码。内容分三部分：学习如何编程（创建对象、用数据结构表示知识、控制流）、写可读且组织良好且模块化的好代码、比较 Python 程序的优劣与效率。",
          "conditions": [
            "课程通过讲座、考试与 psets 组织"
          ],
          "consequences": [
            "学生应通过大量编码练习来掌握课程内容",
            "良好代码风格便于他人阅读与日后重读",
            "课程最后部分讨论程序效率比较"
          ],
          "hint_ids": [
            "F1_5",
            "F1_6"
          ]
        },
        {
          "point_index": 3,
          "topic": "计算、知识与算法",
          "principle": "计算机从根本上执行大量计算并把结果存储在内存中，且只做被明确告知的事。知识分陈述性（事实）与命令式（配方、步骤序列）；配方含步骤序列、控制流与停止方式，即算法。求平方根的例子用猜测、检验是否足够接近、平均更新猜测并重复的步骤说明命令式知识。",
          "conditions": [
            "计算机只知道自己被告知的内容",
            "配方需要步骤序列、控制流与停止方式"
          ],
          "consequences": [
            "计算机能遵循配方但不知道如何处理事实陈述",
            "算法是课程要学习的内容",
            "停止方式由人选择接近程度如 0.01 或 0.001"
          ],
          "hint_ids": [
            "F1_7",
            "F1_8",
            "F1_9",
            "F1_10",
            "F2_1",
            "F2_2",
            "F2_3",
            "F2_4",
            "F2_5",
            "F2_6",
            "F2_7",
            "F2_8"
          ]
        },
        {
          "point_index": 4,
          "topic": "机器架构与可计算性",
          "principle": "固定程序计算机只能做一件事，存储程序计算机可存储并更换指令序列。基本机器架构含内存、输入输出、ALU 与控制单元，程序计数器逐条执行，测试可改变控制流。图灵用六种原语表明可计算任何东西，因此 Python 能算的也可用其他语言实现。",
          "conditions": [
            "存储程序计算机可存储并执行指令序列",
            "控制单元含程序计数器，测试返回真或假"
          ],
          "consequences": [
            "同一台机器可完成不同任务",
            "程序可跳过指令或从头开始",
            "编程语言提供更方便的原语集合"
          ],
          "hint_ids": [
