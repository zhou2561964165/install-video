      "facts": [
        {
          "id": "F1_1",
          "source_id": "part1",
          "source_sha256": "677e869acdebac4c68091e789f44088b14725a355381080260364e1ba4950ebd",
          "start": 698,
          "end": 977,
          "quote": "My name is Ana Bell.\nFirst name, Ana.\nLast name, Bell.\nI'm a lecturer in\nthe EECS Department.\nAnd I'll be giving some\nof the lectures for today,\nalong with later on in the term,\nProfessor Eric Grimson, who's\nsitting right down there, will\nbe giving some of the lectures,\nas well.",
          "topic": "课程开场与授课安排",
          "claim": "Ana Bell 是 EECS 系的讲师，她将讲授本学期 6.0001 和 600 的部分课程，Eric Grimson 教授也将讲授部分课程。",
          "evidence_indices": [
