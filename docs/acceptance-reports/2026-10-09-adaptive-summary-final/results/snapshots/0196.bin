      "candidate": {
        "summary": [
          {
            "text": "讲者HAOHSIANG LIAO提出采用日常评分系统的两个理由：与人互动会留下印象并受评价，故希望每节课都评价学生；并相信只要学生坚持且持续努力修读该课程，就能展现很好的中文技能。通常课后就每位学生的课堂表现提供反馈，涵盖语言与文化行为，让学生知道下节课需改进什么。反馈通常为书面，通过Engrade网站私下留言，学生登录账户即可读到。评论内容取决于学生表现，可简单到提醒发音，也可更详细，如思考如何用中文应对赞美。",
            "fact_ids": [
              "F1_1",
              "F1_2",
              "F1_4"
            ]
          }
        ],
        "key_points": [
          {
            "topic": "日常评分系统的两个理由",
            "text": "讲者提出采用日常评分系统的两个理由：与人互动会留下印象并受评价，故希望每节课都评价学生；并相信只要学生坚持且持续努力修读该课程，就能展现很好的中文技能。",
            "fact_ids": [
              "F1_1"
            ]
          },
          {
            "topic": "课后反馈的内容与目的",
            "text": "讲者表示通常课后就每位学生的课堂表现提供反馈，包括语言和文化行为，目的是让学生知道下节课需要改进什么。",
            "fact_ids": [
              "F1_2"
            ]
          },
          {
            "topic": "通过Engrade网站提供书面反馈",
            "text": "讲者表示通常使用书面反馈，通过名为Engrade的网站，除录入成绩外还可私下给每位学生留言；学生登录账户即可读到教师评论。",
            "fact_ids": [
              "F1_3"
            ]
          },
          {
            "topic": "评论内容取决于学生表现",
            "text": "讲者表示评论内容取决于学生表现，可简单到提醒注意某些发音，也可更详细，例如思考如何用中文应对赞美。",
            "fact_ids": [
              "F1_4"
            ]
          },
          {
            "topic": "中美文化对赞美的不同回应",
            "text": "讲者以美国文化为例，收到赞美时很自然说谢谢；在中国文化中则保持谦逊，不以谢谢接受，有时说还有很长的路要走、不知赞美从何而来，根本观念是保持谦逊。",
            "fact_ids": [
              "F1_5",
              "F1_6"
            ]
          },
          {
            "topic": "针对L1表现的反馈方式",
            "text": "讲者表示若学生课堂表现来自其母语（L1），会鼓励他们，并依据课堂涵盖的教材内容，从如何在中国文化中应对赞美的角度给予反馈，让学生知道这是可努力的方向。",
            "fact_ids": [
              "F1_7"
            ]
          }
        ]
      },
      "theme_plan": [
        {
          "point_index": 1,
          "topic": "日常评分系统的两个理由",
          "principle": "讲者提出采用日常评分系统的两个理由：与人互动会留下印象并受到评价，因此希望每次表现（即每节课）都给学生评价；并相信只要学生坚持且持续努力修读该课程，就能展现很好的中文技能。",
          "conditions": [],
          "consequences": [],
          "hint_ids": [
            "F1_1"
          ]
        },
        {
          "point_index": 2,
